draw cylinder { 0.000 -0.650 -0.000} { 0.000  0.650 -0.000} radius  0.100
draw sphere { 0.000  0.650 -0.000} radius  0.130
draw sphere { 0.000 -0.650 -0.000} radius  0.130
draw color red
draw cylinder { 0.000 -0.000 -0.988} {-0.000  0.000  0.988} radius  0.100
draw sphere {-0.000  0.000  0.988} radius  0.198
draw sphere { 0.000 -0.000 -0.988} radius  0.198

draw color blue
