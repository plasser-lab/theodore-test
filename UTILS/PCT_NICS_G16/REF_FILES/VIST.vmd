draw sphere {-0.538  0.161  1.000} radius  0.108
draw sphere { 0.501 -0.150  0.999} radius  0.108
draw color blue
draw cylinder {-0.189 -0.564  1.000} { 0.152  0.575  1.000} radius  0.100
