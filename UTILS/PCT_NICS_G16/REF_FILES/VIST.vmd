mol new coor0.xyz
axes location Off
display projection Orthographic
display depthcue off
color Display Background white
menu graphics on
mol modstyle 0 0 Licorice 0.100000 30.000000 30.000000
# Uncomment to hide hydrogens
# mol modselect 0 0 not element H

# Use this for rings
mol addrep 0
mol modstyle 1 0 PaperChain 0.050000 10.000000
mol modmaterial 1 0 Glass3
draw delete all

draw color blue
draw cylinder {-0.641 -0.107 -0.000} { 0.641  0.107 -0.000} radius  0.100
draw sphere { 0.641  0.107 -0.000} radius  0.130
draw sphere {-0.641 -0.107 -0.000} radius  0.130
